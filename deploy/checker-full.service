[Unit]
Description=Conferencia de Caixa (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/checker-full
ExecStart=/home/ubuntu/checker-full/.venv/bin/uvicorn servidor:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
